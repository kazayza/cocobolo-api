# COCOBOLO API — required environment variable NAMES (no values here).
# Copy to .env locally, or set the same names in the host (Railway) dashboard.
# NEVER commit a filled .env.

# --- HTTP ---
PORT=

# --- SQL Server (same database as the Blazor app) ---
DB_SERVER=
DB_PORT=
DB_DATABASE=
DB_USER=
DB_PASSWORD=

# --- JWT (REQUIRED, min 32 chars — the app refuses to boot without it) ---
# Either name works; AUTH_JWT_SECRET takes precedence.
AUTH_JWT_SECRET=
JWT_SECRET=

# --- Public share links (REQUIRED for /api/quotations/public/:token) ---
# Must be the SAME value as Blazor's Security:ShareSecret (min 32 chars).
SHARE_SECRET=

# --- CORS (optional) ---
# Comma-separated browser origins. Unset = today's open behavior.
ALLOWED_ORIGINS=

# --- Firebase push (optional; push is disabled safely when unset) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Misc (optional) ---
NODE_ENV=
APP_TIMEZONE=
PUBLIC_WEB_BASE_URL=
SCHEDULER_VERBOSE=
